# Copy to .env and fill in real values locally. Never commit .env.

# LLM (backend only — never shipped to the iOS client)
OPENAI_API_KEY=
# Optional override of the extraction model; defaults to gpt-5-mini.
ATLAS_EXTRACTION_MODEL=
# Optional override of the chat model; defaults to gpt-5-mini.
ATLAS_CHAT_MODEL=
# Optional override of the assistant's persona (system prompt tone/character);
# defaults to a built-in persona in app/config.py if unset.
ATLAS_PERSONA=

# Web search (Milestone 5.3) — free tier at tavily.com
TAVILY_API_KEY=

# Gmail OAuth (Milestone 3 — not needed for earlier increments)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Auth / data (Milestone 6) — from your Supabase project's Settings > API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
