# Copy to .env and fill in real values locally. Never commit .env.

# LLM (backend only — never shipped to the iOS client)
OPENAI_API_KEY=
# Optional override of the extraction model; defaults to gpt-5-mini.
ATLAS_EXTRACTION_MODEL=

# Gmail OAuth (Milestone 3 — not needed for earlier increments)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Auth / data (only once actually needed)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
