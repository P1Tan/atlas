# OpenAI -- used by chat, extraction, embeddings, and (Milestone 7.1) the
# voice scaffold's LLM/STT/TTS services.
OPENAI_API_KEY=

# Web search (Milestone 5.3)
TAVILY_API_KEY=

# Gmail OAuth (Milestone 3 — not needed for earlier increments)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Auth / data (Milestone 6)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Voice pipeline (Milestone 7)
# Milestone 7.1 scaffold (app/voice_agent.py) -- a free LiveKit Cloud
# project's URL/API key/secret. Not used by the FastAPI server itself.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Optional, both have defaults (shown here) -- see app/config.py.
# ATLAS_VOICE_DEV_ROOM_NAME=atlas-dev
# ATLAS_VOICE_DEV_TIMEZONE=America/New_York

# Optional overrides -- all of the below have sane defaults in app/config.py
# and do not need to be set to run the backend.
# ATLAS_PERSONA=
# ATLAS_CHAT_MODEL=gpt-5-mini
# ATLAS_EXTRACTION_MODEL=gpt-5-mini
# ATLAS_EMBEDDING_MODEL=text-embedding-3-small
# ATLAS_GMAIL_LOOKBACK_DAYS=30
